<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:backgroundTint="@color/surface_background"
        android:elevation="0dp"
        app:navigationIconTint="@color/toolbar_icon"
        app:titleTextColor="@color/text_primary" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_background"
        app:tabIndicatorColor="@color/brand_primary_dark"
        app:tabIndicatorFullWidth="false"
        app:tabSelectedTextColor="@color/text_primary"
        app:tabTextColor="@color/text_secondary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="14dp"
                android:background="@color/surface_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSelectedCategory"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardBackgroundColor="@color/brand_secondary"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/textSelectedCategoryIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="7dp"
                        android:scaleX="1.28"
                        android:scaleY="1.28"
                        android:scaleType="fitCenter" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textSelectedCategoryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textAmountPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/label_amount"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/editAmount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:includeFontPadding="false"
                            android:inputType="none"
                            android:maxLines="1"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCategorySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="14dp"
                android:background="@color/surface_card"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never" />

                <LinearLayout
                    android:id="@+id/layoutCategoryPager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/buttonPrevPage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:paddingVertical="6dp"
                        android:text="@string/editor_page_prev"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/textCategoryPage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand_primary_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/buttonNextPage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:paddingVertical="6dp"
                        android:text="@string/editor_page_next"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="14dp"
                android:background="@color/surface_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/layoutAccountRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/labelAccount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_account"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spinnerAccount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutTransferAccountRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/labelTransferAccount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_transfer_account"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spinnerTransferAccount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutDirectionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/labelDirection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/editor_direction"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spinnerDirection"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDate"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.42"
                        android:gravity="start|center_vertical"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonNote"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="0.58"
                        android:gravity="start|center_vertical"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <GridLayout
        android:id="@+id/layoutKeypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_keyboard"
        android:columnCount="5"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp"
        android:useDefaultMargins="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyOne"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="1"
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyTwo"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="2"
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyThree"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="3"
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyPlus"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="+"
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyDelete"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="@string/editor_keyboard_delete"
            android:textColor="@color/text_inverse"
            android:textSize="12sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyFour"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="4"
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyFive"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="5"
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keySix"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="6"
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyMinus"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="-"
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyClear"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="@string/action_clear"
            android:textColor="@color/text_inverse"
            android:textSize="12sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keySeven"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="7"
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyEight"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="8"
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyNine"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="9"
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyMultiply"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="*"
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyDivide"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="/"
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyZero"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="0"
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyDot"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="."
            android:textColor="@color/text_inverse"
            android:textSize="17sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyOk"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:layout_columnSpan="3"
            android:layout_columnWeight="3"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="@string/action_ok"
            android:textColor="@color/text_inverse"
            android:textSize="15sp"
            app:backgroundTint="@color/keypad_fill"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:rippleColor="@color/keypad_ripple"
            app:strokeColor="@color/keypad_stroke"
            app:strokeWidth="1dp" />
    </GridLayout>

</LinearLayout>
